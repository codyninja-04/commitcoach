NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-5-5
CLAUDE_MODEL=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: or https: contact for the push service, required by the Web Push spec
VAPID_SUBJECT=mailto:you@example.com
# Shared secret the reminder cron sends as a Bearer token
CRON_SECRET=
# Set to true to turn on the free plan limits (3 habits, no AI). Off by default until billing exists.
ENFORCE_PRO=false
NEXT_PUBLIC_APP_URL=http://localhost:3000
